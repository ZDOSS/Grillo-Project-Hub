{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grillo Project Hub",
  "version": "0.1.0",
  "identifier": "org.opensource.grilloprojecthub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grillo Project Hub",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "© 2026 Grillo Project Hub contributors",
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
